{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "serve": "(export $(cat .env | egrep -v '#|^$' | xargs) && node .output/server/index.mjs)",
    "inshprod": "NUXT_PUBLIC_THEME=InSilentHill NUXT_PUBLIC_URL=insilenthill.ru NUXT_PUBLIC_API_URL=https://backend.insilenthill.ru NUXT_PUBLIC_SESSION_COOKIE_NAME=insilenthill_session node .output/server/index.mjs"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.10.4",
    "nuxt": "^3.9.1",
    "vue": "^3.4.10",
    "vue-router": "^4.2.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-brands-svg-icons": "^6.5.1",
    "@fortawesome/free-regular-svg-icons": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/vue-fontawesome": "^3.0.5",
    "@pinia/nuxt": "^0.5.1",
    "pinia": "^2.1.7",
    "sass": "^1.69.7",
    "vue-flex-waterfall": "^2.3.0"
  }
}
